  "SundaPy Strict OOP Class": {
    "prefix": "sunda-class",
    "scope": "python",
    "body": [
      "#strict",
      "",
      "class ${1:Entitas}:",
      "    x: f64",
      "    y: f64",
      "    aktif: bool",
      "    ",
      "    def __init__(self, x: f64, y: f64):",
      "        self.x = x",
      "        self.y = y",
      "        self.aktif = True",
      "    ",
      "    def geser(self, dx: f64, dy: f64) -> void:",
      "        self.x = self.x + dx",
      "        self.y = self.y + dy",
      "    ",
      "    def jarak_kuadrat(self) -> f64:",
      "        return self.x * self.x + self.y * self.y",
      "",
      "e = ${1:Entitas}(10.0, 20.0)",
      "e.geser(5.0, -2.0)",
      "print(\"Posisi X:\", e.x, \"Y:\", e.y)"
    ],
    "description": "Template kelas Object-Oriented (OOP) dengan atribut bertipe hardware statis dan metode native."
  },

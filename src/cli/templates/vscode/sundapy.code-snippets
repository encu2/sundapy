      "print(f\"Alamat memori : {ffi.addressof(p)}\")",
      "print(f\"Nilai awal    : x={p.${2:x}}, y={p.${4:y}}\")",
      "p.${2:x} = 42.0",
      "print(f\"Nilai update  : x={p.${2:x}}\")"
    ],
    "description": "Template pembuatan struct native C dengan ffi.create_struct dan inspeksi sizeof/addressof."
  },
  "SundaPy Low-Level FFI & Raw Memory": {
    "prefix": "sunda-ffi-low",
    "scope": "python",
    "body": [
      "import ffi",
      "",
      "lib = ffi.open(\"${1:libnative.so}\")",
      "sym = lib.get_symbol(\"${2:simbol_fungsi}\")",
      "",
      "# Alokasi manual memory buffer (libc malloc)",
      "buf_ptr = ffi.alloc(${3:64})",
      "print(\"Allocated raw pointer:\", buf_ptr)",
      "",
      "# Eksekusi raw function pointer",
      "hasil = lib.call_raw(sym, buf_ptr)",

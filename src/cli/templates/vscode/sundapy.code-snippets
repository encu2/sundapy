  "SundaPy Multi-Core Threading": {
    "prefix": "sunda-thread",
    "scope": "python",
    "body": [
      "import threading",
      "import time",
      "",
      "kunci = threading.Lock()",
      "",
      "def pekerjaan_pekerja(id_worker: int):",
      "    kunci.acquire()",
      "    print(\"Worker\", id_worker, \"sedang berjalan di native thread...\")",
      "    kunci.release()",
      "    time.sleep(0.5)",
      "    kunci.acquire()",
      "    print(\"Worker\", id_worker, \"selesai.\")",
      "    kunci.release()",
      "",
      "threads = []",
      "for i in range(4):",
      "    t = threading.Thread(target=pekerjaan_pekerja, args=(i,))",
      "    threads.append(t)",
      "    t.start()",
      "",
      "for t in threads:",
      "    t.join()",
      "print(\"Seluruh thread multi-core telah selesai.\")"
    ],
    "description": "Template konkurensi multithreading multi-core murni tanpa GIL dengan sinkronisasi Mutex Lock."
  },
  "SundaPy Asynchronous Coroutine": {
    "prefix": "sunda-async",
    "scope": "python",
    "body": [
      "import asyncio",
      "",
      "async def tugas_asinkron(nama: str, jeda: float):",
      "    print(\"Mulai tugas:\", nama)",
      "    await asyncio.sleep(jeda)",
      "    print(\"Tugas selesai:\", nama)",
      "    return f\"Hasil dari {nama}\"",
      "",
      "async def main():",
      "    t1 = asyncio.create_task(tugas_asinkron(\"Download 1\", 1.0))",
      "    t2 = asyncio.create_task(tugas_asinkron(\"Download 2\", 0.5))",
      "    res2 = await t2",
      "    res1 = await t1",
      "    print(\"Semua tugas async tuntas:\", res1, res2)",
      "",
      "asyncio.run(main())"
    ],
    "description": "Template pemrograman asynchronous non-blocking berbasis coroutine dan event loop."
  },

  "SundaPy TCP Socket Server": {
    "prefix": "sunda-tcp-server",
    "scope": "python",
    "body": [
      "import socket",
      "",
      "HOST = \"${1:127.0.0.1}\"",
      "PORT = ${2:8080}",
      "",

  "SundaPy Strict Compute Skeleton": {
    "prefix": "sunda-strict",
    "scope": "python",
    "body": [
      "#strict",
      "import time",
      "",
      "def ${1:hitung_komputasi}(${2:n}: ${3:i64}) -> ${4:i64}:",
      "    \"\"\"",
      "    Fungsi komputasi berkecepatan tinggi dengan tipe hardware murni.",
      "    Semua variabel dialokasikan di register CPU / stack.",
      "    \"\"\"",
      "    total: ${4:i64} = 0",
      "    i: ${3:i64} = 0",
      "    while i < ${2:n}:",
      "        total = total + i",
      "        i = i + 1",
      "    return total",
      "",
      "def main() -> void:",
      "    start: i64 = time.time_ns()",
      "    hasil: ${4:i64} = ${1:hitung_komputasi}(${5:1000000})",
      "    elapsed: i64 = time.time_ns() - start",
      "    print(\"Hasil  :\", hasil)",
      "    print(\"Waktu  :\", elapsed, \"ns\")",
      "",
      "main()"
    ],
    "description": "Template skrip komputasi #strict. Gunakan ini jika membutuhkan performa hardware native maksimal (setara C/Zig)."
  },
  "SundaPy Nanosecond Benchmark": {
    "prefix": "sunda-bench",
    "scope": "python",
    "body": [
      "#strict",
      "import time",
      "",
      "def ${1:fungsi_target}(${2:val}: ${3:i64}) -> ${4:i64}:",
      "    return ${2:val} * 2",
      "",
      "def benchmark() -> void:",
      "    iterasi: i64 = ${5:1000000}",
      "    print(\"Memulai benchmark dengan\", iterasi, \"iterasi...\")",
      "    ",
      "    # Warm-up loop",
      "    w: i64 = 0",
      "    while w < 10000:",
      "        _ = ${1:fungsi_target}(w)",
      "        w = w + 1",
      "    ",
      "    # Pengukuran waktu presisi nanodetik",
      "    t0: i64 = time.time_ns()",
      "    i: i64 = 0",
      "    akumulator: ${4:i64} = 0",
      "    while i < iterasi:",
      "        akumulator = akumulator + ${1:fungsi_target}(i)",
      "        i = i + 1",
      "    t1: i64 = time.time_ns()",
      "    ",
      "    total_ns: i64 = t1 - t0",
      "    avg_ns: f64 = float(total_ns) / float(iterasi)",
      "    print(\"Total Waktu :\", total_ns, \"ns\")",
      "    print(\"Rata-rata   :\", avg_ns, \"ns per panggilan\")",
      "",
      "benchmark()"
    ],
    "description": "Template microbenchmark berpresisi nanodetik dengan fase warm-up dan perhitungan rata-rata latensi."
  },
  "SundaPy 60 FPS Desktop Window": {
    "prefix": "sunda-gui",
    "scope": "python",
    "body": [
      "import screenGUI",
      "import GUIEngine",
      "import time",
      "",
      "WIDTH = ${1:1280}",
      "HEIGHT = ${2:720}",
      "TITLE = \"${3:SundaPy Desktop App (60 FPS)}\"",
      "",
      "def main():",
      "    screenGUI.init(WIDTH, HEIGHT, TITLE)",
      "    canvas = GUIEngine.create_surface(WIDTH, HEIGHT)",
      "    ",
      "    pos_x = 100",
      "    pos_y = 100",
      "    ",
      "    while screenGUI.is_running():",
      "        # 1. Event Polling & Input Handling",
      "        events = screenGUI.poll_events()",
      "        for ev in events:",
      "            if ev.get(\"type\") == \"quit\":",
      "                screenGUI.close()",
      "                return",
      "            if ev.get(\"key\") == \"Escape\":",
      "                screenGUI.close()",
      "                return",
      "        ",
      "        # Deteksi keyboard interaktif",
      "        if screenGUI.is_key_pressed(\"Right\") or screenGUI.is_key_pressed(\"d\"): pos_x += 5",
      "        if screenGUI.is_key_pressed(\"Left\") or screenGUI.is_key_pressed(\"a\"): pos_x -= 5",
      "        if screenGUI.is_key_pressed(\"Up\") or screenGUI.is_key_pressed(\"w\"): pos_y -= 5",
      "        if screenGUI.is_key_pressed(\"Down\") or screenGUI.is_key_pressed(\"s\"): pos_y += 5",
      "        ",
      "        # 2. Rendering Kanvas (GUIEngine)",
      "        GUIEngine.clear(canvas, 20, 24, 32)",
      "        GUIEngine.draw_rect(canvas, WIDTH, HEIGHT, pos_x, pos_y, 60, 60, 0.0, 200.0, 255.0)",
      "        GUIEngine.draw_text(canvas, WIDTH, HEIGHT, \"Gunakan Panah/WASD untuk bergerak\", 20, 20, 2, 255.0, 255.0, 255.0)",
      "        ",
      "        # 3. Presentasi Buffer ke Layar (Zero-Copy SHM)",
      "        screenGUI.render(canvas)",
      "        time.sleep(0.016)  # Target 60 FPS",
      "",
      "main()"
    ],
    "description": "Template aplikasi desktop X11 60 FPS lengkap dengan event loop, input keyboard/mouse, dan zero-copy SHM."
  },

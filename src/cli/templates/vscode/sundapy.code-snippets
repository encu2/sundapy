      "",
      "# Definisi C-compatible struct layout",
      "${1:Point} = ffi.create_struct(\"${1:Point}\", [",
      "    (\"${2:x}\", ${3:ffi.f64}),",
      "    (\"${4:y}\", ${3:ffi.f64})",
      "])",
      "",
      "# Inisiasi dan manipulasi struct di memori native",

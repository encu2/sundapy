{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SundaPy: Run File",
      "type": "shell",
      "command": "sundapy \"${file}\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SundaPy: Run Fast (-O3)",
      "type": "shell",
      "command": "sundapy --fast \"${file}\"",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SundaPy: Build Standalone Binary",
      "type": "shell",
      "command": "sundapy --build --outname \"${fileBasenameNoExtension}\" \"${file}\"",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
